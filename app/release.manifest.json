  "systems": [
    "core",
    "memory",
    "perception",
    "control",
    "evolution"
  ],
  "external_components": {
    "deepseek_api": true,
    "ollama_models": true,
    "cuda_training_stack": true
  },
  "web_debug_preserved": true,
  "release_scope": "Windows x64 v3 main installer plus optional local-model add-on"
}
